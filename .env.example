# === Telegram ===
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_token_here
# Your Telegram user ID (find it via @userinfobot)
TELEGRAM_ALLOWED_USER_ID=123456789

# === Ollama — Mac mini (light tasks: goal parsing, summaries) ===
OLLAMA_MAC_URL=http://localhost:11434
OLLAMA_MAC_MODEL=llama3:14b

# === Ollama — Desktop GPU (heavy tasks: task generation, planning) ===
# Recommended: deepseek-r1:14b  (run: ollama pull deepseek-r1:14b on the desktop)
OLLAMA_DESKTOP_URL=http://192.168.50.206:11434
OLLAMA_DESKTOP_MODEL=deepseek-r1:14b

# === OpenClaw ===
# Running on localhost:18789 (loopback only)
OPENCLAW_URL=http://localhost:18789
# Find your token in OpenClaw settings > API or ~/.openclaw/config.json
OPENCLAW_TOKEN=

# === Scheduler ===
DAILY_TASK_HOUR=8
DAILY_TASK_MINUTE=0
TIMEZONE=America/New_York

# === File paths (relative to repo root) ===
AUTONOMOUS_MD_PATH=AUTONOMOUS.md
TASKS_LOG_PATH=memory/tasks-log.md
